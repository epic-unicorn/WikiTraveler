# ── WikiTraveler Node — Environment Variables ──────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
#
# Documentation: docs/README.md · docs/LOCAL.md · docs/OPERATORS.md

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Vercel Postgres, Neon, Supabase, or self-hosted)
# For Docker Compose Postgres on this machine, keep localhost + POSTGRES_HOST_PORT (default 5432).
DATABASE_URL=postgresql://wikitraveler:wikitraveler@localhost:5432/wikitraveler
# Host port when using docker/docker-compose.yml or docker-compose.dev.yml Postgres (localhost only)
# POSTGRES_HOST_PORT=5432

# ── Node Identity ─────────────────────────────────────────────────────────────
# A stable, unique ID for this node. Used in gossip deltas and peer discovery.
NODE_ID=my-node-1

# The public URL of this node (used when registering with peers and in gossip).
NODE_URL=http://localhost:3000

# Geographic region label — set via Admin (/stats) or offline: pnpm node:region --preset eindhoven

# ── Authentication ────────────────────────────────────────────────────────────
# RS256 key pair for signing JWTs. Generate with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Then set these to the PEM content (replace newlines with \n).
NODE_PRIVATE_KEY=
NODE_PUBLIC_KEY=

# Allow public user registration — configured in Admin (/stats) → Users panel.

# The first admin account is created through the web UI on first launch.
# Navigate to http://localhost:3000 — you will be redirected to /setup automatically.

# Optional: legacy HS256 fallback secret (used only when NODE_PRIVATE_KEY is unset).
# JWT_SECRET=change-me-in-production

# ── CORS ──────────────────────────────────────────────────────────────────────
# Allowed origins for the API. Use "*" to allow all, or a comma-separated list.
CORS_ORIGINS=*

# ── Gossip Protocol ───────────────────────────────────────────────────────────
# How often the gossip cron runs (in hours). Default: 24.
# Set to a small fraction (e.g. 0.003 ≈ 10s) for local demos.
GOSSIP_INTERVAL_HOURS=24

# Secret passed as Authorization: Bearer <value> to protect the cron endpoint.
# Required on Vercel (set in vercel.json referencing @cron-secret).
CRON_SECRET=


# ── AI Agent (Vision + Gap-Fill) ─────────────────────────────────────────────
# Supports any OpenAI-compatible provider. Leave all blank to disable AI features.
#
# ── Option A: OpenAI (default) ────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
#
# ── Option B: Ollama (local, free) ────────────────────────────────────────────
# 1. Install: https://ollama.com  (or: winget install Ollama.Ollama)
# 2. Pull models:
#      ollama pull llama3.2-vision   # for photo analysis
#      ollama pull qwen2.5:7b        # for gap-fill (text-only)
# 3. Set the vars below:
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=ollama
# AI_VISION_MODEL=llama3.2-vision
# AI_TEXT_MODEL=qwen2.5:7b
#
# ── Option C: LM Studio (local GUI, any GGUF model) ──────────────────────────
# 1. Download: https://lmstudio.ai
# 2. Load a vision model (e.g. Llava-1.6) and a chat model, start the local server.
# AI_BASE_URL=http://localhost:1234/v1
# AI_API_KEY=lm-studio
# AI_VISION_MODEL=<loaded-vision-model-name>
# AI_TEXT_MODEL=<loaded-chat-model-name>
#
# ── Shared optional overrides (any provider) ──────────────────────────────────
# AI_BASE_URL=         # leave blank to use official OpenAI endpoint
# AI_API_KEY=          # takes precedence over OPENAI_API_KEY
# AI_VISION_MODEL=     # default: gpt-4o (OpenAI) or model-specific (local)
# AI_TEXT_MODEL=       # default: gpt-4o (OpenAI) or model-specific (local)
OPENAI_API_KEY=

# ── OSM / Overpass Ingestion ─────────────────────────────────────────────────
# Region bounding box is configured in Admin (/stats) — not via env vars.
# Optional: absolute path to a cached Overpass fixture JSON file (cron/CLI only).
# OSM_FIXTURE_PATH=/abs/path/to/scripts/fixtures/netherlands-osm.json

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Optional. When set, Next.js middleware enforces sliding-window limits on
# /api/auth/login, /api/auth/register, and /api/properties/*/accessibility.
# Get a free Redis at https://upstash.com — the free tier covers most nodes.
# Without these, rate limiting is silently skipped.
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# ── AI Scan Budget ────────────────────────────────────────────────────────────
# Max properties the daily AI scan cron processes per run. Default: 20, ceiling: 50.
# The ?limit=N query param can override this per-call (capped at 50).
# MAX_AI_SCAN_PER_RUN=20

# ── Photo Storage ─────────────────────────────────────────────────────────────
# Controls where audit photos are stored. Default (unset): base64 in Postgres.
# Good for demos. For production volume, set to "r2" or "supabase".
#
# PHOTO_STORAGE_PROVIDER=       # leave blank (base64 default), "r2", or "supabase"
#
# ── Cloudflare R2 (free: 10 GB / 1 M writes per month) ──────────────────────
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=wikitraveler-photos
# R2_PUBLIC_URL=https://pub-xxx.r2.dev          # public bucket URL or custom domain
#
# ── Supabase Storage (free: 1 GB on free plan) ───────────────────────────────
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_SERVICE_KEY=
# SUPABASE_STORAGE_BUCKET=photos               # default: "photos"

# ── WikiTraveler Access (apps/access) ───────────────────────────────────────
# Points WikiTraveler Access at your node API. Required when running access separately
# (local dev, Vercel, or Docker — see docs/DOCKER.md and docker-compose.node-access.yml).
NEXT_PUBLIC_NODE_API_URL=http://localhost:3000
# Host port for WikiTraveler Access in Docker (node-access stack or access profile)
# ACCESS_PORT=3001

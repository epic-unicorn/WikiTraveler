{
  "name": "@wikitraveler/sdk",
  "version": "0.3.0",
  "description": "WikiTraveler JS SDK — embed accessibility data into any travel website.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "prepublishOnly": "pnpm build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ingmarstruijs/WikiTraveler.git",
    "directory": "packages/sdk"
  },
  "license": "MIT",
  "devDependencies": {
    "@wikitraveler/core": "workspace:*",
    "@wikitraveler/i18n": "workspace:*",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {},
  "peerDependencies": {}
}

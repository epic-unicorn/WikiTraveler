{
  "name": "wikitraveler",
  "private": true,
  "version": "0.2.0",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm --filter @wikitraveler/i18n build && pnpm --filter @wikitraveler/node dev",
    "dev:access": "pnpm --filter @wikitraveler/access dev",
    "dev:agency-demo": "pnpm --filter @wikitraveler/sdk build && npx serve -p 4000 .",
    "dev:gossip-lab": "docker compose -f docker/docker-compose.gossip.yml up --build",
    "gossip:link-peers": "node scripts/gossip-link-peers.mjs",
    "gossip:seed": "node scripts/gossip-seed.mjs",
    "gossip:sync": "node scripts/gossip-sync.mjs",
    "gossip:crud": "node scripts/gossip-crud.mjs",
    "gossip:reingest": "node scripts/gossip-reingest.mjs",
    "gossip:check": "node scripts/gossip-check.mjs",
    "release:prepare": "node scripts/release.mjs",
    "build": "pnpm --filter @wikitraveler/core build && pnpm --filter @wikitraveler/i18n build && pnpm --filter @wikitraveler/i18n build:browser && pnpm --filter @wikitraveler/ui build && pnpm --filter @wikitraveler/ai-agent build && pnpm --filter @wikitraveler/sdk build && pnpm --filter @wikitraveler/node build && pnpm --filter @wikitraveler/access build",
    "lint": "pnpm --recursive lint",
    "test": "pnpm --filter @wikitraveler/node test && pnpm --filter @wikitraveler/access test",
    "test:a11y": "pnpm --filter @wikitraveler/node test:a11y",
    "lighthouse:prepare": "pnpm --filter @wikitraveler/node exec tsx ../../scripts/prepare-lighthouse.ts",
    "lighthouse:ci": "lhci autorun",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --tsconfig apps/node/tsconfig.json scripts/seed.ts && tsx scripts/seed-fields.ts",
    "db:setup": "prisma migrate reset --force && tsx --tsconfig apps/node/tsconfig.json scripts/seed.ts && tsx scripts/seed-fields.ts",
    "db:migrate-photos": "pnpm --filter @wikitraveler/node db:migrate-photos",
    "node:region": "tsx --tsconfig apps/node/tsconfig.json scripts/node-region.ts",
    "node:ingest": "tsx --tsconfig apps/node/tsconfig.json scripts/node-ingest.ts",
    "node:export": "tsx --tsconfig apps/node/tsconfig.json scripts/node-export.ts",
    "node:import": "tsx --tsconfig apps/node/tsconfig.json scripts/node-import.ts",
    "node:build-sample": "tsx --tsconfig apps/node/tsconfig.json scripts/node-build-sample.ts",
    "geocode:missing": "tsx --tsconfig apps/node/tsconfig.json scripts/geocode-missing-coords.ts",
    "osm:ingest": "pnpm node:ingest overpass",
    "osm:import-pbf": "pnpm node:ingest pbf",
    "osm:import-pbf:docker": "docker compose -f docker/docker-compose.dev.yml exec node pnpm node:ingest pbf",
    "osm:import-pbf:docker:prod": "docker compose -f docker/docker-compose.yml exec node osm-import-pbf",
    "docker:access": "docker compose -f docker/docker-compose.yml --profile access up -d",
    "docker:access:dev": "docker compose -f docker/docker-compose.dev.yml --profile access up -d",
    "docker:reset": "docker compose -f docker/docker-compose.yml --profile access down -v",
    "postinstall": "prisma generate"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@lhci/cli": "^0.14.0",
    "@types/node": "^20.19.37",
    "prisma": "^5.14.0",
    "tsx": "^4.15.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0"
  }
}

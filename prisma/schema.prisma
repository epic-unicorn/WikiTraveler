// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Reliability tier enum — mirrors the core package
// ---------------------------------------------------------------------------
enum Tier {
  OFFICIAL
  AI_GUESS
  VERIFIED
  CONFIRMED
}

// ---------------------------------------------------------------------------
// Source type — which external system or pipeline originated the fact
// ---------------------------------------------------------------------------
enum SourceType {
  WIKIDATA
  WHEELMAP
  OSM
  WHEEL_THE_WORLD
  AUDITOR
}

enum FieldScope {
  PROPERTY
  ROOM
}

enum ValueType {
  BOOLEAN
  NUMBER
  TEXT
  TIME
  ENUM
}

// ---------------------------------------------------------------------------
// Travel property (keyed by Wikidata Q-identifier)
// ---------------------------------------------------------------------------
model Property {
  id          String   @id @default(cuid())
  canonicalId String   @unique
  name        String
  location    String
  lat         Float?
  lon         Float?
  dataSource  String   @default("NODE_ORIGINAL")
  osmId       String?  @unique
  wheelmapId  String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  facts      AccessibilityFact[]
  audits     AuditSubmission[]
  signals    CommunitySignal[]
  metadataOverrides PropertyMetadataOverride[]
}

// ---------------------------------------------------------------------------
// Manual metadata overrides — field-level corrections that sync across nodes
// ---------------------------------------------------------------------------
model PropertyMetadataOverride {
  id            String     @id @default(cuid())
  propertyId    String
  property      Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  canonicalId   String
  fieldName     String     // name | location | lat | lon
  value         String
  sourceType    SourceType @default(AUDITOR)
  sourceNodeId  String
  submittedBy   String?
  signatureHash String?
  timestamp     DateTime   @default(now())
  clearedAt     DateTime?

  @@unique([canonicalId, fieldName, sourceNodeId])
  @@index([canonicalId])
  @@index([propertyId])
  @@index([timestamp])
}

// ---------------------------------------------------------------------------
// A single accessibility fact for a property
// ---------------------------------------------------------------------------
model AccessibilityFact {
  id            String     @id @default(cuid())
  propertyId    String
  property      Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  fieldName     String
  scopeKey      String     @default("property")
  value         String
  tier          Tier       @default(OFFICIAL)
  sourceType    SourceType @default(AUDITOR)
  sourceNodeId  String
  submittedBy   String?
  signatureHash String?
  valueLocale   String?
  timestamp     DateTime   @default(now())

  translations FactTranslation[]

  @@unique([propertyId, fieldName, sourceNodeId, scopeKey])
  @@index([propertyId])
  @@index([tier])
  @@index([scopeKey])
}

model FactTranslation {
  id             String   @id @default(cuid())
  factId         String
  fact           AccessibilityFact @relation(fields: [factId], references: [id], onDelete: Cascade)
  sourceLocale   String
  targetLocale   String
  sourceHash     String
  translatedText String
  provider       String   @default("deepl")
  createdAt      DateTime @default(now())

  @@unique([factId, targetLocale])
  @@index([factId])
}

// ---------------------------------------------------------------------------
// Field registry — global standard fields + node-specific custom fields
// ---------------------------------------------------------------------------
model FieldDefinition {
  id           String     @id @default(cuid())
  fieldName    String     @unique
  scope        FieldScope @default(PROPERTY)
  valueType    ValueType  @default(BOOLEAN)
  enumValues   String[]   @default([])
  labels       Json
  unit         String?
  nodeId       String?
  searchFilter Boolean    @default(false)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// ---------------------------------------------------------------------------
// Raw community audit submission (kept for audit trail)
// ---------------------------------------------------------------------------
model AuditSubmission {
  id           String   @id @default(cuid())
  propertyId   String
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  auditorToken String?
  locale       String?
  // JSON array of { fieldName, value, scopeKey? } objects
  facts        Json
  // Legacy JSON array — kept for backward compatibility during migration
  photoUrls    Json     @default("[]")
  createdAt    DateTime @default(now())

  photos AuditPhoto[]

  @@index([propertyId])
}

model AuditPhoto {
  id           String          @id @default(cuid())
  submissionId String
  submission   AuditSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  url          String
  caption      String?
  fieldName    String?
  scopeKey     String?
  width        Int?
  height       Int?
  sortOrder    Int             @default(0)
  capturedAt   DateTime        @default(now())

  @@index([submissionId])
}

// ---------------------------------------------------------------------------
// OSM ingestion sync state — legacy per-bbox sync rows (kept for backup compat)
// ---------------------------------------------------------------------------
model OsmSyncState {
  id        String    @id @default(cuid())
  bbox      String    @unique
  lastSync  DateTime?
  itemCount Int?
  updatedAt DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Node region — bbox and display region configured via admin (not env)
// ---------------------------------------------------------------------------
model NodeSettings {
  id               String    @id @default("default")
  bbox             String?   // "minLat,minLon,maxLat,maxLon"
  region           String?   // auto-derived label
  presetId         String?
  configuredAt     DateTime?
  lastIngestAt     DateTime?
  lastIngestCount  Int?
  openRegistration Boolean   @default(true)
  auditedReimportPending Boolean @default(false) // true after region move until audited re-import
  updatedAt        DateTime  @updatedAt
}

enum IngestJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum IngestJobPhase {
  PURGING
  FETCHING
  INGESTING
  DONE
}

// ---------------------------------------------------------------------------
// Async OSM ingest jobs — admin-triggered region setup / changes
// ---------------------------------------------------------------------------
model IngestJob {
  id         String           @id @default(cuid())
  status     IngestJobStatus  @default(PENDING)
  phase      IngestJobPhase?
  bbox       String
  changeType String?          // initial | shrink | expand | move | refresh
  tileCount  Int?
  tilesDone  Int              @default(0)
  progress   Int              @default(0)
  message    String?
  stats      Json?
  error      String?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime         @default(now())
  tiles      IngestJobTile[]
}

enum IngestJobTileStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model IngestJobTile {
  id           String              @id @default(cuid())
  jobId        String
  index        Int
  bbox         String
  status       IngestJobTileStatus @default(PENDING)
  elementCount Int?
  error        String?
  startedAt    DateTime?
  finishedAt   DateTime?
  job          IngestJob           @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, index])
}

// ---------------------------------------------------------------------------
// Community signals — traveler reports for auditor triage (not facts)
// ---------------------------------------------------------------------------
enum SignalType {
  MISSING
  INCORRECT
  OUTDATED
  LOCATION
  DEMAND
}

enum SignalStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

model CommunitySignal {
  id             String       @id @default(cuid())
  propertyId     String
  property       Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  type           SignalType
  status         SignalStatus @default(OPEN)
  fieldName      String?
  scopeKey       String?      @default("property")
  currentValue   String?
  currentTier    Tier?
  suggestedValue String?
  note           String?
  visitDate      DateTime?
  photos         Json         @default("[]")
  reporterId     String
  resolvedBy     String?
  resolution     String?
  resolvedAt     DateTime?
  priorityScore  Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([propertyId, status])
  @@index([status, priorityScore])
  @@index([reporterId])
}

// ---------------------------------------------------------------------------
// User roles
// ---------------------------------------------------------------------------
enum Role {
  USER    // can read the API and use the Lens extension
  AUDITOR // can submit field audits via WikiTraveler Access or node dashboard
  ADMIN   // full access: user management, backup/restore, stats
}

// ---------------------------------------------------------------------------
// User accounts — one account per node, identity is username@homeNodeUrl
// ---------------------------------------------------------------------------
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Peer node registry
// ---------------------------------------------------------------------------
model NodePeer {
  id               String   @id @default(cuid())
  url              String   @unique
  nodeId           String?
  region           String?
  bbox             String?  // "minLat,minLon,maxLat,maxLon"
  publicKey        String?  // RSA public key PEM — cached from peer's /api/nodeinfo
  lastKnownVersion String?  // Cached from peer /api/nodeinfo `version`
  gossipProtocol   Int?     // Cached gossip wire protocol from /api/nodeinfo
  lastSeen         DateTime @default(now())
  isActive         Boolean  @default(true)
}

// ---------------------------------------------------------------------------
// Gossip sync history
// ---------------------------------------------------------------------------
model GossipSnapshot {
  id           String   @id @default(cuid())
  fromNodeId   String
  snapshotHash String
  appliedAt    DateTime @default(now())
  factCount    Int      @default(0)
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Reliability tier enum — mirrors the core package
// ---------------------------------------------------------------------------
enum Tier {
  OFFICIAL
  AI_GUESS
  VERIFIED
  CONFIRMED
}

// ---------------------------------------------------------------------------
// Source type — which external system or pipeline originated the fact
// ---------------------------------------------------------------------------
enum SourceType {
  WIKIDATA
  WHEELMAP
  OSM
  WHEEL_THE_WORLD
  AUDITOR
}

enum FieldScope {
  PROPERTY
  ROOM
}

enum ValueType {
  BOOLEAN
  NUMBER
  TEXT
  TIME
  ENUM
}

// ---------------------------------------------------------------------------
// Travel property (keyed by Wikidata Q-identifier)
// ---------------------------------------------------------------------------
model Property {
  id          String   @id @default(cuid())
  canonicalId String   @unique
  name        String
  location    String
  lat         Float?
  lon         Float?
  dataSource  String   @default("NODE_ORIGINAL")
  osmId       String?  @unique
  wheelmapId  String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  facts      AccessibilityFact[]
  audits     AuditSubmission[]
}

// ---------------------------------------------------------------------------
// A single accessibility fact for a property
// ---------------------------------------------------------------------------
model AccessibilityFact {
  id            String     @id @default(cuid())
  propertyId    String
  property      Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  fieldName     String
  scopeKey      String     @default("property")
  value         String
  tier          Tier       @default(OFFICIAL)
  sourceType    SourceType @default(AUDITOR)
  sourceNodeId  String
  submittedBy   String?
  signatureHash String?
  timestamp     DateTime   @default(now())

  @@unique([propertyId, fieldName, sourceNodeId, scopeKey])
  @@index([propertyId])
  @@index([tier])
  @@index([scopeKey])
}

// ---------------------------------------------------------------------------
// Field registry — global standard fields + node-specific custom fields
// ---------------------------------------------------------------------------
model FieldDefinition {
  id           String     @id @default(cuid())
  fieldName    String     @unique
  scope        FieldScope @default(PROPERTY)
  valueType    ValueType  @default(BOOLEAN)
  enumValues   String[]   @default([])
  labels       Json
  unit         String?
  nodeId       String?
  searchFilter Boolean    @default(false)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// ---------------------------------------------------------------------------
// Raw community audit submission (kept for audit trail)
// ---------------------------------------------------------------------------
model AuditSubmission {
  id           String   @id @default(cuid())
  propertyId   String
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  auditorToken String?
  locale       String?
  // JSON array of { fieldName, value, scopeKey? } objects
  facts        Json
  // Legacy JSON array — kept for backward compatibility during migration
  photoUrls    Json     @default("[]")
  createdAt    DateTime @default(now())

  photos AuditPhoto[]

  @@index([propertyId])
}

model AuditPhoto {
  id           String          @id @default(cuid())
  submissionId String
  submission   AuditSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  url          String
  caption      String?
  fieldName    String?
  scopeKey     String?
  width        Int?
  height       Int?
  sortOrder    Int             @default(0)
  capturedAt   DateTime        @default(now())

  @@index([submissionId])
}

// ---------------------------------------------------------------------------
// OSM ingestion sync state — tracks last Overpass fetch per bounding box
// ---------------------------------------------------------------------------
model OsmSyncState {
  id        String    @id @default(cuid())
  bbox      String    @unique
  lastSync  DateTime?
  itemCount Int?
  updatedAt DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// User roles
// ---------------------------------------------------------------------------
enum Role {
  USER    // can read the API and use the Lens extension
  AUDITOR // can submit field audits via Field Kit or node dashboard
  ADMIN   // full access: user management, backup/restore, stats
}

// ---------------------------------------------------------------------------
// User accounts — one account per node, identity is username@homeNodeUrl
// ---------------------------------------------------------------------------
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Peer node registry
// ---------------------------------------------------------------------------
model NodePeer {
  id        String   @id @default(cuid())
  url       String   @unique
  nodeId    String?
  region    String?
  bbox      String?  // "minLat,minLon,maxLat,maxLon"
  publicKey String?  // RSA public key PEM — cached from peer's /api/nodeinfo
  lastSeen  DateTime @default(now())
  isActive  Boolean  @default(true)
}

// ---------------------------------------------------------------------------
// Gossip sync history
// ---------------------------------------------------------------------------
model GossipSnapshot {
  id           String   @id @default(cuid())
  fromNodeId   String
  snapshotHash String
  appliedAt    DateTime @default(now())
  factCount    Int      @default(0)
}

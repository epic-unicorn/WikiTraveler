{
  "manifest_version": 3,
  "name": "WikiTraveler Lens",
  "version": "0.3.0",
  "description": "Community-verified accessibility data on booking websites — popup panel and listing-page tooltips.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://www.booking.com/*",
    "*://*.expedia.com/*",
    "*://*.hotels.com/*",
    "*://localhost/*",
    "*://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.booking.com/*",
        "*://*.expedia.com/*",
        "*://*.hotels.com/*",
        "*://localhost/*",
        "*://127.0.0.1/*"
      ],
      "js": [
        "i18n.js",
        "locale.js",
        "nodeApi.js",
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
